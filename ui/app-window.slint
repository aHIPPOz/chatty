import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

component TopBar inherits Rectangle {
    background: #1e1e2e;
    height: 40px;

    HorizontalBox {
        padding: 8px;
        spacing: 8px;

        Text {
            text: "🐧 Shell Desktop";
            font-size: 14px;
            font-weight: 700;
            color: #cdd6f4;
        }

        Rectangle { background: transparent; }

        Text {
            text: "14:30 | 🔊 100% | 🔋 88%";
            font-size: 12px;
            color: #a6adc8;
        }
    }
}

component TaskBar inherits Rectangle {
    background: #313244;
    height: 50px;

    HorizontalBox {
        padding: 8px;
        spacing: 4px;

        Button { text: "🖥️ Terminal"; width: 110px; }
        Button { text: "📁 Files"; width: 110px; }
        Button { text: "📝 Editor"; width: 110px; }

        Rectangle { background: transparent; }
    }
}

component AppLauncher inherits Rectangle {
    background: rgba(30, 30, 46, 0.95);
    border-radius: 12px;
    width: 340px;

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "📱 Applications";
            font-size: 18px;
            font-weight: 700;
            color: #cdd6f4;
        }

        VerticalBox {
            spacing: 8px;

            HorizontalBox {
                spacing: 8px;
                Button { width: 60px; height: 60px; text: "Terminal"; }
                Button { width: 60px; height: 60px; text: "📁"; }
                Button { width: 60px; height: 60px; text: "📝"; }
                Button { width: 60px; height: 60px; text: "🌐"; }
            }

            HorizontalBox {
                spacing: 8px;
                Button { width: 60px; height: 60px; text: "⚙️"; }
                Button { width: 60px; height: 60px; text: "🎵"; }
                Button { width: 60px; height: 60px; text: "🎮"; }
                Button { width: 60px; height: 60px; text: "💬"; }
            }
        }
    }
}

component VirtualWindow inherits Rectangle {
    background: #313244;
    border-radius: 8px;
    width: 280px;
    height: 180px;

    in-out property <string> window-title: "Window";
    in-out property <bool> window-focused: false;

    VerticalBox {
        spacing: 0px;

        Rectangle {
            background: root.window-focused ? #89b4fa : #45475a;
            height: 28px;

            HorizontalBox {
                padding: 4px;
                spacing: 8px;

                Text {
                    text: root.window-title;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.window-focused ? #1e1e2e : #cdd6f4;
                }

                Rectangle { background: transparent; }

                Button {
                    width: 20px;
                    height: 20px;
                    text: "×";
                }
            }
        }

        Rectangle {
            background: #1e1e2e;
            border-radius: 0px;

            Text {
                text: "[" + root.window-title + " - running...]";
                color: #89b4fa;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }
        }
    }
}

component WorkspaceButton inherits Button {
    width: 28px;
    height: 28px;
}

export component AppWindow inherits Window {
    width: 1280px;
    height: 720px;
    background: #11111b;
    title: "Shell Desktop - WASM Demo";

    in-out property <bool> show-launcher: false;
    in-out property <int> active-ws: 1;

    VerticalBox {
        spacing: 0px;

        TopBar {}

        HorizontalBox {
            spacing: 12px;

            Rectangle {
                width: 110px;
                background: #1e1e2e;
                border-radius: 8px;

                VerticalBox {
                    padding: 12px;
                    spacing: 12px;

                    Text {
                        text: "Workspaces";
                        font-size: 11px;
                        font-weight: 700;
                        color: #a6adc8;
                    }

                    Rectangle {
                        background: #313244;
                        border-radius: 6px;

                        HorizontalBox {
                            padding: 6px;
                            spacing: 2px;

                            WorkspaceButton {
                                text: "1";
                                clicked => { root.active-ws = 1; }
                            }
                            WorkspaceButton {
                                text: "2";
                                clicked => { root.active-ws = 2; }
                            }
                            WorkspaceButton {
                                text: "3";
                                clicked => { root.active-ws = 3; }
                            }
                            WorkspaceButton {
                                text: "4";
                                clicked => { root.active-ws = 4; }
                            }
                        }
                    }

                    Text {
                        text: "WS: " + root.active-ws;
                        font-size: 10px;
                        color: #89b4fa;
                    }
                }
            }

            Rectangle {
                background: #1a1a2e;
                border-radius: 8px;

                HorizontalBox {
                    padding: 12px;
                    spacing: 12px;

                    if root.show-launcher : AppLauncher {}

                    if !root.show-launcher : VerticalBox {
                        spacing: 12px;

                        HorizontalBox {
                            spacing: 12px;

                            VirtualWindow {
                                window-title: "Terminal";
                                window-focused: true;
                            }

                            VirtualWindow {
                                window-title: "Files";
                                window-focused: false;
                            }

                            VirtualWindow {
                                window-title: "Editor";
                                window-focused: false;
                            }
                        }

                        Rectangle {
                            background: transparent;
                        }
                    }
                }
            }
        }

        TaskBar {}
    }

    // Launcher toggle button (using key binding simulation)
    callback toggle-launcher;
    toggle-launcher => {
        root.show-launcher = !root.show-launcher;
    }
}

